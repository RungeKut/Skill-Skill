#!/bin/sh
here=$(cd "$(dirname "$0")/.." && { pwd -W 2>/dev/null || pwd; })
root=$(git rev-parse --show-toplevel)
for py in python3 python py; do
    if command -v "$py" >/dev/null 2>&1 && "$py" -c "import sys" >/dev/null 2>&1; then
        exec "$py" "$here/tools/check_msg.py" --root "$root" "$1"
    fi
done
cat >&2 <<'EOF'

  КОММИТ ОТКЛОНЁН: не найден рабочий Python — текст коммита не проверен.
  Причина: в PATH оболочки, из которой запущен git, нет настоящего
  Python; «python» из WindowsApps — заглушка Microsoft Store (код 49).
  Решение: добавить каталог Python в PATH и повторить коммит, например
  в PowerShell:  $env:Path = "<каталог Python>;" + $env:Path
  Если Python есть в PATH пользователя, хватит нового терминала.
  Подробно: skill-skill, knowledge/30_ГРАБЛИ/30-02.

EOF
exit 1
